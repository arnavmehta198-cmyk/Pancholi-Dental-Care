# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard > Project Settings > API). The anon key is meant to be
# public/client-side — it's safe to embed as long as Row Level Security
# policies are in place (see supabase/schema.sql). Never put the
# service_role key in this file or anywhere in client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
